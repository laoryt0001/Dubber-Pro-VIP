# Dubber Pro VIP License Server - Environment Configuration

# Server Port and Host
PORT=3000
HOST=0.0.0.0

# Directory for SQLite database and Ed25519 keys (Default: ./data)
DATA_DIR=./data

# Admin Dashboard Initial Credentials
ADMIN_USER=admin
ADMIN_PASS=admin123

# Optional: Ed25519 Keys in PEM format (replaces data/keys.json if defined)
# ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
